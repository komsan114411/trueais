# ─────────────────────────────────────────────────────────────
#  ตั้งค่าระบบเติมเงิน — คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามจริง
#  (ไฟล์ .env ห้ามอัปโหลดขึ้น Git หรือส่งให้คนอื่น)
# ─────────────────────────────────────────────────────────────

# พอร์ตและที่อยู่เว็บไซต์ (ใช้สร้างลิงก์ callback ให้ WonDD เรียกกลับ)
PORT=3000
PUBLIC_URL=http://localhost:3000

# IP ลูกค้าจริงเมื่อวางระบบหลัง proxy (ใช้กับการจำกัดความถี่ / จำกัด IP ของ API key)
#   เว้นว่าง          = ลูกค้าเข้าระบบตรงๆ ไม่มี proxy (เช่น เปิดในเครื่องด้วย start.bat)
#   loopback          = มี Nginx/Caddy อยู่เครื่องเดียวกัน
#   loopback,uniquelocal = ใช้ docker-compose ที่มากับระบบ + Nginx บนเครื่อง
#   หรือใส่ IP/วงของ proxy เช่น 10.0.0.5 หรือ 173.245.48.0/20 (คั่นด้วย ,)
#   ตัวเลข (เช่น 1) ก็ใช้ได้ — ระบบจะเชื่อเฉพาะ proxy ที่อยู่ในเครื่อง/เครือข่ายภายในเท่านั้น (คนนอกปลอม IP ไม่ได้)
#   ใช้ Cloudflare โดยไม่มี Nginx → ใส่วง IP ของ Cloudflare (https://www.cloudflare.com/ips/) แทนตัวเลข
TRUST_PROXY=

# บัญชีผู้ดูแลระบบคนแรก (สร้างให้อัตโนมัติตอนเปิดระบบครั้งแรก ถ้ายังไม่มีแอดมิน)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=ผู้ดูแลระบบ

# ─── ผู้ให้บริการ (ร้าน) ─────────────────────────────────────────
# ใส่ได้หลายเจ้า คั่นด้วย , เรียงตามลำดับความสำคัญ — ลูกค้าเลือกร้านเองได้ และถ้าร้านที่เลือกไม่รับรายการ
# ระบบส่งต่อร้านอื่นอัตโนมัติ (เฉพาะกรณีมั่นใจว่าร้านแรกยังไม่ได้ทำรายการ)
#  mock,mock2 = ร้านทดสอบ A และ B (จำลอง ไม่เสียเงินจริง) — ค่าเริ่มต้น ไว้ลองเลือกร้าน/สลับร้าน
#  hubzell    = HubZell จริง (ดู docs/HUBZELL-INTEGRATION.md)
#  wondd      = WonDD จริง (ต้องได้ API จาก WonDD ก่อน)
#  ตัวอย่างใช้งานจริง: PROVIDERS=hubzell,wondd   (ปน mock/mock2 กับเจ้าจริง = เซิร์ฟเวอร์ไม่ยอมเปิด)
PROVIDERS=mock,mock2

# เวลารอผลจากผู้ให้บริการ (มิลลิวินาที) และจำนวนคำขอพร้อมกัน
PROVIDER_TIMEOUT_MS=30000
PROVIDER_CONCURRENCY=2
PROVIDER_MIN_INTERVAL_MS=300

# ─── WonDD API (ได้จาก WonDD หลังอนุมัติเปิดใช้ API) ────────────
WONDD_API_URL=
WONDD_USERNAME=
WONDD_API_KEY=
WONDD_API_SECRET=
# การยืนยัน callback จาก WonDD (ระบบปฏิเสธ callback ที่ไม่ผ่านการยืนยันเสมอ):
#   - ถ้า WonDD มีลายเซ็นให้ ใส่รหัสลับที่นี่ (แนะนำที่สุด)
#   - ถ้ารู้ IP ของ WonDD ใส่ใน WONDD_CALLBACK_IPS (คั่นด้วย ,)
#   - ถ้าไม่มีทั้งสองอย่าง ระบบใช้รหัสลับใน URL (?t=...) ที่แสดงในหน้าแอดมิน → ผู้ให้บริการ
#   callback ที่ไม่มีลายเซ็น ระบบจะเช็กสถานะกับ WonDD ซ้ำก่อนขยับเงินทุกครั้ง
WONDD_CALLBACK_SECRET=
WONDD_CALLBACK_IPS=

# ─── HubZell (https://shop.hubzell.com/docs) ───────────────────
# API key และ secret key จากหน้า Developer ใน HubZell Reseller Console
# ⚠️ ต้องเพิ่ม IP ของเซิร์ฟเวอร์ใน IP Whitelist ที่หน้า Developer ก่อน (ไม่อย่างนั้นทุกคำขอถูกปฏิเสธ)
# ⚠️ HubZell ไม่มี sandbox — ทุกรายการเป็นของจริง ทดสอบด้วยยอดเล็กก่อน
HUBZELL_API_URL=https://gateway.hubzell.com/api/v1
HUBZELL_API_KEY=
HUBZELL_SECRET_KEY=
# ใช้เฉพาะถ้าตั้ง "Webhook endpoint" (whsec_...) แทน Callback URL
HUBZELL_WEBHOOK_SECRET=
HUBZELL_CURRENCY=THB
# จำนวนคำขอสูงสุดต่อนาที (HubZell จำกัด 120 — ตั้งต่ำกว่านั้นไว้)
HUBZELL_RATE_PER_MIN=100
# ส่งรายการใหม่ไป HubZell พร้อมกันได้สูงสุดกี่รายการ (1-5) — กันยิงรัวตอนบัญชีมีปัญหา (KYC ซ้ำ 5 ครั้ง = HubZell บล็อก IP 24 ชม.)
HUBZELL_MAX_CONCURRENT=2

# ─── แจ้งเตือนแอดมิน (ไม่บังคับ) ─────────────────────────────────
# LINE Messaging API (LINE Notify ปิดบริการแล้ว)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── ขั้นสูง ───────────────────────────────────────────────────
# ตัวนำหน้าเลขที่รายการ เช่น TP261101ABCD1234
ORDER_REF_PREFIX=TP
# อนุญาตให้ฝังหน้าเว็บใน iframe ของเว็บไซต์อื่น เช่น https://www.myshop.com (none = ไม่อนุญาต)
FRAME_ANCESTORS=none
# วันหมดอายุการล็อกอิน (ต่ออายุอัตโนมัติเมื่อใช้งาน แต่ไม่เกิน SESSION_MAX_DAYS นับจากล็อกอิน)
SESSION_DAYS=7
SESSION_MAX_DAYS=30
# แอดมินไม่ได้ใช้งานกี่ชั่วโมงแล้วต้องล็อกอินใหม่
ADMIN_SESSION_IDLE_HOURS=12
# อนุญาตให้ webhook ส่งไป localhost / IP ภายใน (เปิดเฉพาะตอนทดสอบในเครื่อง ห้ามเปิดในระบบจริง)
WEBHOOK_ALLOW_PRIVATE=
